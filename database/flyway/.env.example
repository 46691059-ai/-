# Copy to a secure, untracked environment file or inject these variables from CI/CD.
# Never commit real credentials.

FLYWAY_IMAGE=redgate/flyway:13.0.0
FLYWAY_VENDOR=mysql
FLYWAY_URL='jdbc:mysql://127.0.0.1:3306/enterprise_platform?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false'
FLYWAY_USER=enterprise_migrator
FLYWAY_PASSWORD=
FLYWAY_DOCKER_NETWORK=

DB_NAME=enterprise_platform
EXPECTED_SOURCE_DB_VERSION=2.0.0
EXPECTED_TARGET_DB_VERSION=2.1.3
EXPECTED_PRE_SCHEMA_FINGERPRINT=
EXPECTED_POST_SCHEMA_FINGERPRINT=

# Deprecated compatibility variables. Leave unset in new release pipelines.
EXPECTED_DB_VERSION=
EXPECTED_SCHEMA_FINGERPRINT=

# Required by the MySQL schema-fingerprint check. Keep credentials in this file,
# not in command arguments. Example content is documented in the integration plan.
MYSQL_CLIENT_DEFAULTS_FILE=

# Required for mutating commands in preprod/prod.
CHANGE_TICKET=
CONFIRM_FLYWAY_MUTATION=
