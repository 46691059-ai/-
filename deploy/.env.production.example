PUBLIC_ORIGIN=https://platform.example.gov.cn
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80

DB_NAME=enterprise_platform
DB_USERNAME=enterprise
DB_POOL_MIN_IDLE=5
DB_POOL_MAX_SIZE=30
REDIS_DATABASE=0

JWT_ISSUER=enterprise-platform
JWT_AUDIENCE=enterprise-platform-api
JWT_EXPIRATION_SECONDS=7200

WORKFLOW_BASE_URL=https://workflow.example.gov.cn
WORKFLOW_DECISION_DEFINITION_KEY=investment-decision
WORKFLOW_DECISION_DEFINITION_VERSION=1
WORKFLOW_HMAC_CURRENT_KEY_ID=replace-with-managed-key-id
WORKFLOW_OUTBOX_WORKER_ENABLED=false

# Required Docker secret files under deploy/secrets/ (never commit their contents):
# workflow_service_token.txt
# workflow_callback_token.txt
# workflow_hmac_current_secret.txt

BACKEND_IMAGE=enterprise-platform-backend:1.0.0
FRONTEND_IMAGE=enterprise-platform-frontend:1.0.0

MYSQL_MEMORY_LIMIT=2g
MYSQL_CPU_LIMIT=2.0
REDIS_MAXMEMORY=512mb
REDIS_MEMORY_LIMIT=768m
REDIS_CPU_LIMIT=1.0
BACKEND_MEMORY_LIMIT=1536m
BACKEND_CPU_LIMIT=2.0
FRONTEND_MEMORY_LIMIT=256m
FRONTEND_CPU_LIMIT=1.0

LOG_MAX_SIZE=20m
LOG_MAX_FILES=10
BACKUP_RETENTION_DAYS=30
